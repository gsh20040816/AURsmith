{
	admin off
}

https://{$AURSMITH_WEB_HOST:desktop.example.invalid}:8443 {
	tls /run/secrets/web_tls_fullchain /run/secrets/web_tls_private_key
	encode zstd gzip
	handle /api/* {
		reverse_proxy controller:8080
	}
	handle /healthz {
		reverse_proxy controller:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'"
	}
}
