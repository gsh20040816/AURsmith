# 复制为 deploy/server/.env 后填写。
AURSMITH_PUBLIC_ORIGIN=https://aursmith.example.com
AURSMITH_REPOSITORY_BASE_URL=https://repo.example.com
AURSMITH_REPOSITORY_NAME=aursmith
# printf '%s' "$(cat ../home/secrets/builder_token)" | sha256sum
AURSMITH_BUILDER_TOKEN_SHA256=
# 宿主机仓库目录：signer 写入，宿主 Caddy 以静态文件提供；属主需为 10001:10001。
AURSMITH_REPOSITORY_HOST_DIR=/srv/aursmith/repo
# 可选
# AURSMITH_UPDATE_INTERVAL_MINUTES=30
# AURSMITH_ARCH_HTTPS_PROXY=http://192.168.64.1:19443
# AURSMITH_WEB_BIND=127.0.0.1:18443
