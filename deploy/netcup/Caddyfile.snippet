aursmith.shgao.top {
	@health path /healthz
	respond @health 404
	# Builder 上传分片为 32 MiB；Cloudflare 代理时单个请求体上限 100 MB。
	request_body {
		max_size 40MB
	}
	reverse_proxy 127.0.0.1:18443
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'"
	}
}

repo.shgao.top {
	handle_path /arch-cache/* {
		rewrite * /repo/archlinux{path}
		reverse_proxy 127.0.0.1:19129
	}
	# signer 写入的仓库目录（AURSMITH_REPOSITORY_HOST_DIR），直接静态提供。
	handle {
		root * /srv/aursmith/repo
		file_server
	}
	@database path *.db *.db.* *.files *.files.* *.sig
	header @database Cache-Control "no-cache, must-revalidate"
	@package path *.pkg.tar.*
	header @package Cache-Control "no-cache, must-revalidate"
	header X-Content-Type-Options nosniff
}
